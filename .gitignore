# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python
pip-log.txt

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── Linting / formatting ──────────────────────────────────────────────────────
.ruff_cache/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# ── Local tool settings ───────────────────────────────────────────────────────
.claude/settings.local.json

# ── Windows OS artifacts ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Database / cache files ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── PyInstaller ───────────────────────────────────────────────────────────────
# dist/ and build/ already covered above.
# WinClientTool.spec is intentionally tracked (build config).

# ── Project-specific runtime artifacts ───────────────────────────────────────
config/user_config.json

# security catalog probe output (evidence lives in .superpowers/sdd/)
tools/_probe_*
# security_catalog_check.ps1 / security_roundtrip_llmnr.ps1 write these
tools/_check_elevated.*
tools/_roundtrip_elevated.*

# Measurement and render harnesses, kept out of the tree like dist/
scratchpad/

# pytest basetemp (see pyproject.toml: parent must exist, so not under build/)
.pytest-tmp/

# Test-run transcripts written into the repo root by a background pytest.
suite*.txt
full_suite.txt

# Superpowers git worktree fallback (isolated per-plan workspaces)
.worktrees/
