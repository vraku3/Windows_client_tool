{
  "name": "Performance",
  "version": 1,
  "builtin": true,
  "description": "Maximize system performance: power plan, visual effects, NTFS tweaks, CPU/memory optimizations, and background service reduction.",
  "tweaks": {
    "performance": [
      "disable_superfetch",
      "high_perf_power_plan",
      "disable_search_indexing",
      "visual_effects_best_performance",
      "disable_transparency",
      "disable_ntfs_8dot3",
      "disable_ntfs_last_access",
      "enable_hags",
      "boost_multimedia_scheduling",
      "instant_menu_response",
      "disable_startup_delay",
      "disable_edge_preload",
      "keep_kernel_in_ram",
      "boost_foreground_cpu_priority",
      "disable_prefetch"
    ],
    "services": [
      "disable_delivery_optimization",
      "disable_xbox_services",
      "disable_fax",
      "disable_tablet_input",
      "disable_connected_devices_platform",
      "disable_alljoyn_router",
      "disable_downloaded_maps_manager",
      "disable_diagnostics_hub",
      "disable_remote_registry"
    ],
    "network": [
      "disable_qos_reserved_bandwidth",
      "optimise_dns_cache"
    ],
    "ui_tweaks": [
      "disable_taskbar_news",
      "disable_taskbar_widgets",
      "disable_snap_suggestions",
      "disable_peek_desktop"
    ],
    "power": [
      "power_disable_power_throttling",
      "power_disable_hibernate_file"
    ],
    "privacy": [
      "disable_background_apps_global"
    ],
    "telemetry": [
      "disable_wersvc",
      "disable_diagtrack"
    ],
    "multimedia": [
      "mm_disable_network_throttling"
    ],
    "taskbar_&_start": [
      "taskbar_disable_taskbar_animations"
    ]
  },
  "apps": {}
}
