  {
    "id": "disable_diag_track_blocking",
    "name": "Block DiagTrack Service (Block Task)",
    "description": "Blocks the DiagTrack service from running at all by setting it to a blocked task. Stronger than just setting start_type=disabled.",
    "category": "Telemetry",
    "risk": "medium",
    "requires_admin": true,
    "steps": [
      {
        "type": "service",
        "name": "DiagTrack",
        "start_type": "disabled"
      },
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\Application Experience\\AitAgent"
      },
      {
        "type": "scheduled_task",
        "task_name": "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater"
      }
    ]
  },
  {
    "id": "disable_auto_logger",
    "name": "Disable Windows AutoLogger",
    "description": "Stops the AutoLogger-Diagtrack-Listener ETW trace session that collects diagnostic events at boot, by setting its Start value to 0. Takes effect at the next restart.",
    "category": "Telemetry",
    "risk": "medium",
    "requires_admin": true,
    "steps": [
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger\\AutoLogger-Diagtrack-Listener",
        "value": "Start",
        "data": 0,
        "kind": "DWORD"
      },
      {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger\\Diagtrack-Listener",
        "value": "Start",
        "data": 0,
        "kind": "DWORD"
      }
    ]
  },
