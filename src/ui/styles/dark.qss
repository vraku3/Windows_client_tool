/* ============================================================
   Dark theme — VS Code-inspired palette
   Background: #0d1117   Surface: #161b22   Elevated: #21262d
   Border:     #30363d   Text:    #e6edf3   Muted:    #9ea7b3
   Accent:     #2f81f7   Green:   #3fb950   Red:      #f85149
   ============================================================ */

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0d1117;
}

QFrame {
    background-color: #0d1117;
}

QFrame[frameShape="1"],
QFrame[frameShape="4"] {
    border: 1px solid #30363d;
    border-radius: 4px;
    background-color: #161b22;
}

/* ---- Sidebar nav list ---- */
QListWidget {
    background-color: #161b22;
    border: none;
    border-right: 1px solid #30363d;
    outline: none;
}

QListWidget::item {
    padding: 10px 16px;
    border-left: 3px solid transparent;
}

QListWidget::item:selected {
    background-color: #292f38;
    border-left: 3px solid #2f81f7;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #1f242c;
}

QStackedWidget {
    background-color: #0d1117;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #3b434d;
    border-radius: 3px;
    padding: 5px 14px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #292f38;
    border-color: #484f58;
}

QPushButton:pressed {
    background-color: #1c2128;
}

QPushButton:disabled {
    background-color: #21262d;
    color: #6e7681;
    border-color: #30363d;
}

/* ---- Inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #30363d;
    color: #e6edf3;
    border: 1px solid #3b434d;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #1c3d6e;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #2f81f7;
}

/* ---- Combo box ---- */
QComboBox {
    background-color: #30363d;
    color: #e6edf3;
    border: 1px solid #3b434d;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:hover { border-color: #2f81f7; }

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #3b434d;
    selection-background-color: #1f6feb;
}

/* ---- Spin box ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #30363d;
    color: #e6edf3;
    border: 1px solid #3b434d;
    border-radius: 3px;
    padding: 3px 6px;
}

/* ---- Checkbox / Radio ---- */
QCheckBox, QRadioButton {
    color: #e6edf3;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3b434d;
    background-color: #30363d;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #2f81f7;
    border-color: #2f81f7;
}

QRadioButton::indicator { border-radius: 7px; }
QRadioButton::indicator:checked {
    background-color: #2f81f7;
    border-color: #2f81f7;
}

QLabel {
    color: #e6edf3;
    background: transparent;
}

/* ---- Group box ---- */
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 14px;
    padding: 8px;
    color: #c9d1d9;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid #30363d;
    border-top: none;
    background-color: #0d1117;
}

QTabBar::tab {
    background-color: #21262d;
    color: #9ea7b3;
    border: 1px solid #30363d;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0d1117;
    color: #ffffff;
    font-weight: bold;
    border-top: 2px solid #2f81f7;
    border-bottom: 1px solid #0d1117;
}

QTabBar::tab:hover:!selected {
    background-color: #292f38;
    color: #e6edf3;
}

/* ---- Scroll bars ---- */
QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3b434d;
    min-height: 20px;
    border-radius: 4px;
    margin: 1px 2px;
}

QScrollBar::handle:vertical:hover { background: #6e7681; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #0d1117;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3b434d;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px 1px;
}

QScrollBar::handle:horizontal:hover { background: #6e7681; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ---- Tables / Trees ---- */
QTableView, QTreeView, QListView {
    background-color: #0d1117;
    alternate-background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    gridline-color: #21262d;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QTreeView::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #21262d;
    color: #c9d1d9;
    border: none;
    border-right: 1px solid #30363d;
    border-bottom: 1px solid #30363d;
    padding: 5px 8px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #292f38;
    color: #e6edf3;
}

QHeaderView::section:vertical {
    background-color: #161b22;
    color: #9ea7b3;
    font-weight: normal;
    padding: 2px 6px;
}

QTableCornerButton::section {
    background-color: #21262d;
    border: none;
    border-right: 1px solid #30363d;
    border-bottom: 1px solid #30363d;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #30363d;
    border: none;
    border-radius: 3px;
    text-align: center;
    color: #e6edf3;
}

QProgressBar::chunk {
    background-color: #2f81f7;
    border-radius: 3px;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #30363d;
}

QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical   { height: 3px; }
QSplitter::handle:hover       { background-color: #2f81f7; }

/* ---- Menus ---- */
QMenuBar {
    background-color: #21262d;
    color: #e6edf3;
    border-bottom: 1px solid #30363d;
}

QMenuBar::item:selected {
    background-color: #292f38;
}

QMenu {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
}

QMenu::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 4px 0;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #21262d;
    border-bottom: 1px solid #30363d;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    color: #e6edf3;
    border: none;
    padding: 4px 8px;
    border-radius: 3px;
}

QToolButton:hover    { background-color: #292f38; }
QToolButton:pressed  { background-color: #1c2128; }
QToolButton:checked  { background-color: #1f6feb; }

/* ---- Status bar ---- */
QStatusBar {
    background-color: #2f81f7;
    color: #ffffff;
}

QStatusBar::item { border: none; }

/* ---- Misc ---- */
QScrollArea {
    border: none;
    background-color: #0d1117;
}

QToolTip {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #3b434d;
    padding: 4px 8px;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background: #30363d;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #2f81f7;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #2f81f7;
    border-radius: 2px;
}

/* ---- Named roles panes ask for by objectName ----
   These exist so a pane can say WHAT a widget is instead of hardcoding a
   colour inline. An inline setStyleSheet() beats the application sheet and is
   never revisited on a theme change, which is how whole panes stayed dark
   under the light theme. Anything colour-bearing belongs here, in both sheets.
*/
QPushButton#accentButton {
    background-color: #1f6feb;
    color: #ffffff;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton#accentButton:hover {
    background-color: #388bfd;
}

QPushButton#accentButton:disabled {
    background-color: #21262d;
    color: #6e7681;
    border: 1px solid #30363d;
}

QPushButton#dangerButton, QPushButton#_uninstall_btn {
    background-color: #b62324;
    color: #ffffff;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton#dangerButton:hover, QPushButton#_uninstall_btn:hover {
    background-color: #da3633;
}

QPushButton#dangerButton:disabled, QPushButton#_uninstall_btn:disabled {
    background-color: #2d1618;
    color: #6e7681;
    border: 1px solid #30363d;
}

QLabel#infoNote {
    background-color: #161b22;
    color: #9ea7b3;
    font-size: 11px;
    border-radius: 4px;
    padding: 8px;
}

QFrame#card {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

/* Secondary text. A literal grey here is a dark-theme grey: #aaaaaa is 1.9:1
   on a light pane. Panes ask for the role and let the sheet pick. */
QLabel#muted {
    color: #9ea7b3;
}

/* Roles the Dashboard's newer tabs ask for instead of inline sheets. */
QLabel#mutedTitle {
    color: #9ea7b3;
    font-weight: bold;
}
QLabel#sectionTitle {
    font-weight: bold;
}
QLabel#mono {
    font-family: Consolas, "Courier New", monospace;
}

/* Network Diagnostics' collapsible _ToolCard header -- a flat title bar,
   deliberately unlike the default QPushButton (no border, left-aligned
   text). A role rather than an inline sheet so it still follows a theme
   switch. */
QPushButton#toolCardHeader {
    text-align: left;
    padding: 6px 10px;
    font-weight: bold;
    border: none;
    background-color: #21262d;
}

QPushButton#toolCardHeader:hover {
    background-color: #292f38;
}

/* DebloatModule's cross-tab "Removed this session" banner (P06). Same
   muted grey as QLabel#muted above -- kept as its own selector because the
   objectName also doubles as this widget's findChild lookup key in
   tests/test_debloat_module.py. */
QLabel#_removed_this_session_banner {
    color: #9ea7b3;
    padding: 4px 8px;
}

/* ---- Semantic label roles ----------------------------------------------
   Set with `label.setObjectName("statusError")` rather than an inline
   stylesheet. An inline sheet beats this one and never changes again, so a
   pane that writes `color: #f44336` keeps it through a theme switch; a role
   follows the theme. Colours match core/semantic_colors.py, which holds
   each to 4.5:1 against its own pane background. ---- */
QLabel#statusError   { color: #f85149; font-weight: bold; }
QLabel#statusWarning { color: #e3b341; font-weight: bold; }
QLabel#statusSuccess { color: #3fb950; font-weight: bold; }
QLabel#statusInfo    { color: #58a6ff; }
QLabel#heading       { font-size: 16px; font-weight: bold; }
QLabel#metric        { font-size: 18px; font-weight: bold; }
QLabel#link          { color: #58a6ff; }

/* Plain-language introduction at the top of a pane (ui/module_intro.py).
   Use the card surface for this theme; the OS alternate-base palette can
   belong to the opposite theme. The phosphor recolouring also covers it. */
QLabel#moduleIntro {
    background-color: #161b22;
    border-left: 3px solid palette(highlight);
    border-radius: 3px;
    padding: 6px 10px;
}

/* ---- Monitor Control ---------------------------------------------------
   A notice the pane shows only when it has something to report, and the
   per-monitor active/inactive markers. Roles rather than inline sheets: an
   inline sheet beats this one and never changes again, so a dark-theme
   colour written into the widget survives a switch to the light theme. */
QLabel#noticeBanner {
    color: #e3b341;
    border: 1px solid #4d3e22;
    border-radius: 4px;
    padding: 6px 10px;
}
QWidget#adminBanner {
    background-color: #805500;
    padding: 4px;
}
QLabel#monitorActive   { color: #3fb950; }
QLabel#monitorInactive { color: #9ea7b3; }

/* Read-only monospace text panes (log-style detail views). */
QPlainTextEdit#mono {
    font-family: Consolas, "Cascadia Mono", monospace;
}

/* Script Library output console. Colours come from the widget's PALETTE
   (set from the chosen scheme -- PowerShell blue by default), the font from
   the property rules below: the application stylesheet sets every widget's
   font, which a plain setFont() cannot beat. Generated by
   modules/scripts_hub/console_style.qss_rules() -- keep both themes equal. */
QPlainTextEdit#iseConsole {
    background-color: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
    font-family: "Lucida Console", Consolas, monospace;
    font-size: 10pt;
    border: 1px solid #3b434d;
    border-radius: 0px;
    padding: 4px;
}
QPlainTextEdit#iseConsole[consoleFont="lucida"] { font-family: "Lucida Console", Consolas, monospace; }
QPlainTextEdit#iseConsole[consoleFont="consolas"] { font-family: Consolas, monospace; }
QPlainTextEdit#iseConsole[consoleFont="cascadia"] { font-family: "Cascadia Mono", Consolas, monospace; }
QPlainTextEdit#iseConsole[consoleFont="courier"] { font-family: "Courier New", monospace; }
QPlainTextEdit#iseConsole[consoleSize="9"] { font-size: 9pt; }
QPlainTextEdit#iseConsole[consoleSize="10"] { font-size: 10pt; }
QPlainTextEdit#iseConsole[consoleSize="11"] { font-size: 11pt; }
QPlainTextEdit#iseConsole[consoleSize="12"] { font-size: 12pt; }
QPlainTextEdit#iseConsole[consoleSize="13"] { font-size: 13pt; }
QPlainTextEdit#iseConsole[consoleSize="14"] { font-size: 14pt; }
QPlainTextEdit#iseConsole[consoleSize="16"] { font-size: 16pt; }

/* ---- Cleanup redesign: shared roles ------------------------------------
   The objectNames every Cleanup pane uses instead of inline sheets, so the
   header, tiles, cards and empty states follow a theme switch. The same
   names, with light colours, are in light.qss; the phosphor themes get them
   by recolouring this sheet. `safetyBadge` has no rule on purpose: the badge
   is painted by a delegate from core.semantic_colors, not by the sheet.
   Contrast (WCAG): every text colour below is >= 4.5:1 on its background,
   measured by tests/test_chart_palette.py. ---- */
QFrame#cleanupHeader {
    background-color: #161b22;
    border: none;
    border-bottom: 1px solid #30363d;
}

/* A KPI tile is a card (QFrame#card) under another name, so the tiles can be
   found and styled without catching every other card in the app. */
QFrame#kpiTile {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}
/* Labels inside these surfaces take the surface, not the pane colour
   (light.qss gives QLabel no background of its own, so without this a
   title would sit in a pane-coloured band on a white card). */
QFrame#cleanupHeader QLabel, QFrame#kpiTile QLabel, QFrame#chartCard QLabel,
QFrame#recoCard QLabel, QFrame#recoCardHigh QLabel {
    background: transparent;
}
QLabel#kpiValue {
    color: #e6edf3;
    font-size: 20px;
    font-weight: bold;
}
QLabel#kpiCaption {
    color: #9ea7b3;
    font-size: 11px;
}

/* Charts paint chrome("surface") (#161b22) themselves; the card is the same
   colour so the chart has no visible box inside it, and the chart palette's
   3:1 contrast is measured against exactly this colour. */
QFrame#chartCard {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}
QLabel#chartTitle {
    color: #e6edf3;
    font-weight: bold;
}

/* Recommendation cards: the left edge carries the severity, and the card
   also carries an icon shape and words, so colour is never the only cue. */
QFrame#recoCard {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-left: 4px solid #58a6ff;
    border-radius: 6px;
}
QFrame#recoCardHigh {
    background-color: #211618;
    border: 1px solid #5c2b2e;
    border-left: 4px solid #f85149;
    border-radius: 6px;
}

/* The detail pane beside every area tab (a QTextBrowser). */
QWidget#detailPane {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px;
}

/* "No data -- click Scan": centred, muted, never a blank box. */
QLabel#emptyState {
    color: #9ea7b3;
    font-size: 13px;
    padding: 24px;
}

/* Shared glance, intro, filter and state components. */
QFrame#glanceTile { background: #161b22; border: 1px solid #3b434d; border-radius: 8px; }
QFrame#glanceTile:focus { border: 2px solid #2f81f7; }
QFrame#glanceTile QLabel { background: transparent; }
QLabel#glanceValue { font-size: 26px; font-weight: bold; color: #e6edf3; }
QLabel#glanceCaption { font-size: 11px; color: #9ea7b3; }
QToolButton#introToggle { padding: 3px 8px; border: none; color: #e6edf3; }
QToolButton#introToggle:checked { font-weight: bold; }
QLabel#introDetails { color: #9ea7b3; padding: 4px 0; }
QPushButton#chip, QPushButton#filterChip { background: #161b22; color: #e6edf3; border: 1px solid #3b434d; border-radius: 14px; padding: 5px 12px; }
QPushButton#chip[zero="true"], QPushButton#filterChip[zero="true"] { color: #9ea7b3; }
QPushButton#chip:checked, QPushButton#filterChip:checked { background: #2f81f7; color: #ffffff; border-color: #2f81f7; font-weight: bold; }
QPushButton#chip:focus, QPushButton#filterChip:focus { border: 2px solid #2f81f7; }
QLabel#emptyGlyph { font-size: 34px; }
QLabel#emptyTitle { font-size: 16px; font-weight: bold; }
QLabel#emptyHint { color: #9ea7b3; }
QTableView[scanTable="true"] { alternate-background-color: #141920; }

QLabel#introSummary { background: transparent; border: none; padding: 0; }
QWidget#tweakRow:hover { background-color: #1f242c; }

/* ---- Error banner ---- */
QWidget#errorBanner {
    background-color: #3b1518;
    border: 1px solid #f85149;
    border-radius: 4px;
}
QLabel#errorBannerLabel {
    font-size: 12px;
}
QPushButton#errorBannerClose {
    background: transparent;
    color: #9ea7b3;
    border: none;
    font-size: 16px;
    padding: 0 4px;
}
QPushButton#errorBannerClose:hover {
    color: #ffffff;
}

/* ---- Command palette ---- */
QDialog#commandPalette {
    background-color: #161b22;
    border: 1px solid #3b434d;
    border-radius: 6px;
}
QDialog#commandPalette QLineEdit {
    background-color: #30363d;
    border: none;
    border-bottom: 1px solid #3b434d;
    padding: 10px 14px;
    font-size: 14px;
}
QDialog#commandPalette QListWidget {
    background-color: #161b22;
    border: none;
    font-size: 13px;
    outline: none;
}
QDialog#commandPalette QListWidget::item {
    padding: 7px 14px;
}
QDialog#commandPalette QListWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}
QDialog#commandPalette QListWidget::item:hover {
    background-color: #1f242c;
}

/* ---- Cleanup components ---- */
QToolButton#categoryMoreBtn::menu-indicator {
    image: none;
    width: 0px;
}
QFrame#chartCard QStackedWidget,
QFrame#chartCard QStackedWidget > QWidget,
QFrame#chartCard QWidget#categoryGroup,
QFrame#chartCard QWidget#categoryRow,
QFrame#chartCard QWidget#categoryPathsBox,
QFrame#chartCard QWidget#categoryRows,
QFrame#chartCard QWidget#categoryColumns,
QFrame#chartCard QTreeWidget#categoryPaths {
    background: transparent;
}
