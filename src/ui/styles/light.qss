/* ============================================================
   Light theme
   Background: #f5f5f5   Surface: #ffffff   Elevated: #ececec
   Border:     #d4d4d4   Text:    #1e1e1e   Muted:    #6a6a6a
   ============================================================ */

/* The base rule dark.qss has always had, and this sheet did not.
   Without it an unstyled widget falls back to the Qt PALETTE, and Qt6 takes
   that from the OS colour scheme -- so on a machine in Windows dark mode the
   light theme rendered whole panes at #1e1e1e. It also carries the font, which
   otherwise differed between the two themes. */
QWidget {
    background-color: #f5f5f5;
    color: #1e1e1e;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f5f5f5;
    color: #1e1e1e;
}

QTabWidget::pane {
    border: 1px solid #d4d4d4;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #ececec;
    color: #1e1e1e;
    padding: 8px 16px;
    border: 1px solid #d4d4d4;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 2px solid #007acc;
}

QToolBar {
    background-color: #e8e8e8;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QStatusBar {
    background-color: #007acc;
    color: white;
}

QLineEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #c8c8c8;
    padding: 4px 8px;
    border-radius: 2px;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

QPushButton {
    background-color: #0e639c;
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #1177bb;
}
QPushButton:pressed {
    background-color: #094771;
}
/* A disabled button must LOOK disabled. Without this it kept the solid blue
   and white text of an enabled one, so the Log Viewer's "Load earlier" on a
   log that fits whole read as perfectly clickable and did nothing. The dark
   sheet has always said this; the light one never did. */
QPushButton:disabled {
    background-color: #d6d6d6;
    color: #8c8c8c;
}

QTableView, QTreeView, QListView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
    alternate-background-color: #f5f5f5;
    selection-background-color: #cce4f7;
    selection-color: #1e1e1e;
}

QHeaderView::section {
    background-color: #e8e8e8;
    color: #1e1e1e;
    padding: 4px 8px;
    border: 1px solid #d4d4d4;
}

QMenuBar {
    background-color: #e8e8e8;
    color: #1e1e1e;
}

QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
}

QMenu::item:selected {
    background-color: #cce5ff;
}

QCheckBox {
    color: #1e1e1e;
}

QLabel {
    color: #1e1e1e;
}

/* ---- Named roles panes ask for by objectName ----
   These exist so a pane can say WHAT a widget is instead of hardcoding a
   colour inline. An inline setStyleSheet() beats the application sheet and is
   never revisited on a theme change, which is how whole panes stayed dark
   under the light theme. Anything colour-bearing belongs here, in both sheets.
*/
QPushButton#accentButton {
    background-color: #0a5a8f;
    color: #ffffff;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton#accentButton:hover {
    background-color: #094771;
}

QLabel#infoNote {
    background-color: #ececec;
    color: #5a5a5a;
    font-size: 11px;
    border-radius: 4px;
    padding: 8px;
}

QFrame#card {
    background-color: #ececec;
    border: 1px solid #d4d4d4;
    border-radius: 8px;
}

/* ---- Progress bar: light.qss had no rule at all, so panes wrote their own
   dark one inline and it survived the theme switch. ---- */
QProgressBar {
    background-color: #dcdcdc;
    border: none;
    border-radius: 3px;
    text-align: center;
    color: #1e1e1e;
}

QProgressBar::chunk {
    background-color: #007acc;
    border-radius: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #dcdcdc;
}

/* Secondary text. A literal grey here is a dark-theme grey: #aaaaaa is 1.9:1
   on a light pane. Panes ask for the role and let the sheet pick. */
QLabel#muted {
    color: #5a5a5a;
}

/* ============================================================
   Parity block — the 61 selectors dark.qss styled and this sheet
   did not.

   A widget the dark sheet styles and this one does not keeps the Qt
   PALETTE default, and Qt6 takes that from the OS colour scheme: on a
   machine in Windows dark mode, those widgets rendered dark inside an
   otherwise light app. Every scrollbar, combo box, list, group box,
   tooltip, slider and tool button was in that state.

   The values are derived from this sheet's own palette, NOT inverted from
   the dark one. core/semantic_colors.py documents why inverting fails:
   the same hue that reads 7.7:1 on #1e1e1e reads 1.98:1 on #f5f5f5.

   Palette:  bg #f5f5f5  surface #ffffff  elevated #ececec
             border #d4d4d4  text #1e1e1e  muted #6a6a6a
             accent #007acc  selection #cce4f7
   ============================================================ */

QFrame {
    background-color: #f5f5f5;
}

QFrame[frameShape="1"], QFrame[frameShape="4"] {
    border: 1px solid #d4d4d4;
    border-radius: 4px;
    background-color: #ffffff;
}

QStackedWidget {
    background-color: #f5f5f5;
}

QScrollArea {
    border: none;
    background-color: #f5f5f5;
}

/* ---- Sidebar / lists ---- */
QListWidget {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #d4d4d4;
    outline: none;
}

QListWidget::item {
    padding: 10px 16px;
    border-left: 3px solid transparent;
}

QListWidget::item:selected {
    background-color: #cce4f7;
    border-left: 3px solid #007acc;
    color: #1e1e1e;   /* not #ffffff: white on #cce4f7 is 1.5:1 */
}

QListWidget::item:hover:!selected {
    background-color: #ececec;
}

/* ---- Inputs ---- */
QComboBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #007acc;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #c8c8c8;
    selection-background-color: #cce4f7;
    selection-color: #1e1e1e;
}

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 3px 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #8c8c8c;
    background-color: #ffffff;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

QRadioButton {
    color: #1e1e1e;
    spacing: 6px;
}

/* ---- Grouping ---- */
QGroupBox {
    border: 1px solid #d4d4d4;
    border-radius: 4px;
    margin-top: 14px;
    padding: 8px;
    color: #5a5a5a;   /* the dark sheet's #858585 is 2.5:1 here */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QDialog {
    background-color: #f5f5f5;
    color: #1e1e1e;
}

/* ---- Text areas ---- */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
    border-radius: 3px;
    selection-background-color: #cce4f7;
    selection-color: #1e1e1e;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #007acc;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #f5f5f5;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #8c8c8c;
    min-height: 20px;
    border-radius: 4px;
    margin: 1px 2px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #f5f5f5;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #8c8c8c;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px 1px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- Tables and trees ---- */
QTableView::item, QTreeView::item {
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: #dcdcdc;
    color: #1e1e1e;
}

/* ---- Splitters ---- */
QSplitter::handle {
    background-color: #d4d4d4;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

/* ---- Menus ---- */
QMenuBar::item:selected {
    background-color: #cce4f7;
}

QMenu::separator {
    height: 1px;
    background-color: #d4d4d4;
    margin: 4px 0;
}

/* ---- Toolbar buttons ---- */
QToolButton {
    background-color: transparent;
    color: #1e1e1e;
    border: none;
    padding: 4px 8px;
    border-radius: 3px;
}

QToolButton:hover {
    background-color: #dcdcdc;
}

QToolButton:pressed {
    background-color: #c8c8c8;
}

QToolButton:checked {
    background-color: #cce4f7;
}

QStatusBar::item {
    border: none;
}

/* ---- Tooltips ---- */
QToolTip {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #c8c8c8;
    padding: 4px 8px;
    border-radius: 3px;
}

/* ---- Sliders ---- */
QSlider::groove:horizontal {
    background: #d4d4d4;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #007acc;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #007acc;
    border-radius: 2px;
}

/* ---- Semantic label roles ----------------------------------------------
   The light half of the roles dark.qss defines. Darkened rather than
   reused: #4ec9b0 reads 7.7:1 on a dark pane and 1.98:1 on a light one,
   which is the arithmetic core/semantic_colors.py exists to state. ---- */
QLabel#statusError   { color: #b3261e; font-weight: bold; }
QLabel#statusWarning { color: #8a5300; font-weight: bold; }
QLabel#statusSuccess { color: #00695c; font-weight: bold; }
QLabel#statusInfo    { color: #00639c; }
QLabel#heading       { font-size: 16px; font-weight: bold; }
QLabel#metric        { font-size: 18px; font-weight: bold; }
QLabel#link          { color: #00639c; }

/* ---- Monitor Control ---------------------------------------------------
   A notice the pane shows only when it has something to report, and the
   per-monitor active/inactive markers. Roles rather than inline sheets: an
   inline sheet beats this one and never changes again, so a dark-theme
   colour written into the widget survives a switch to the light theme. */
QLabel#noticeBanner {
    color: #8a5300;
    border: 1px solid #c8b96a;
    border-radius: 4px;
    padding: 6px 10px;
}
QLabel#monitorActive   { color: #00695c; }
QLabel#monitorInactive { color: #5f5f5f; }
